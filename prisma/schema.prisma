// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


enum Role {
  OWNER
  CASHIER
}

enum Plan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum OrganizationType {
  RETAIL
  WHOLESALE
  GROCERY
  SUPERMARKET
  PHARMACY
  ELECTRONICS
  FASHION
  HARDWARE
  BEAUTY
  BOOKSTORE
  STATIONERY
  AUTO_PARTS
  MOBILE_SHOP
  FURNITURE
  WAREHOUSE
  DISTRIBUTION
  ECOMMERCE
  OTHER
}

enum PaymentMethod {
  CASH
  MOMO
  CARD
}


enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DiscountScope {
  CART       // whole basket
  PRODUCT    // only specific products
  CATEGORY   // only specific categories
}

enum DiscountSource {
  COUPON
  MANUAL
}


model Organization{
  id  String @id @default(uuid())
  organizationName String
  organizationType OrganizationType
  location String
  contact String
  maxCashierDiscountPercent Float    @default(10) 
  plan               Plan               @default(FREE)
  subscriptionStatus SubscriptionStatus @default(INACTIVE)
  subscriptionExpiry DateTime?
  paystackCustomerId String?
   trialStart    DateTime?

  trialEnd      DateTime?
  createdAt  DateTime @default(now())


  users User[]
  products Product[]
  categories Category[]
  credits Credit[]
  coupons Coupon[]
  vouchers Voucher[]
  
  sales Sale[]
}

model User{
  id String @id @default(uuid())
  name String
  email String @unique
  password String
  role Role @default(CASHIER)
  resetToken      String?
resetTokenExpiry DateTime?

  organizationId String
  organization  Organization @relation(fields:[organizationId], references: [id]) 
  sales Sale[]

  createdAt DateTime @default(now())
}

model Product {
  id        String   @id @default(uuid())
  name      String
  costPrice     Float
  sellingPrice     Float
  quantity  Int      @default(0)
  barcode String? @unique
  imageUrl String?
  createdAt DateTime @default(now())

  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id])

  

  categoryId String
category   Category @relation(fields: [categoryId], references: [id])
  saleItems SaleItem[]

 
}


model Category {
  id   String @id @default(uuid())
  name String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  products Product[]
}







model Sale{
  id           String       @id @default(uuid())
  totalAmount Float
  
  createdAt DateTime @default(now())
  items SaleItem[]
  amountPaid    Float?
  paymentMethod PaymentMethod?
  change       Float? 
  subtotal       Float?
  discountAmount Float           @default(0)
  discountSource DiscountSource?
  discountNote   String? 
  couponCode     String? 
  voucherId      String?
  couponId       String?
  coupon         Coupon?  @relation(fields: [couponId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId String
user   User @relation(fields: [userId], references: [id])
  
}

model SaleItem{
  id String @id @default(uuid())
  quantity Int
  priceAtSale Float
  discountAmount Float @default(0)
  
  createdAt DateTime @default(now())

  saleId String
  sales Sale @relation(fields: [saleId] , references:[id])
  productId String
product   Product @relation(fields: [productId], references: [id])

}

model Credit {
  id             String       @id @default(uuid())
  customerName   String
  customerPhone  String?
  amount         Float
  amountPaid     Float        @default(0)
  note           String?
  isPaid         Boolean      @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}


model Coupon {
  id                String        @id @default(uuid())
  code              String
  description       String?
  type              DiscountType
  value             Float                       // percent (0-100) or GHS amount
  maxDiscountAmount Float?                      // cap for percentage coupons
  minPurchaseAmount Float?                      // basket subtotal must reach this
  scope             DiscountScope @default(CART)
  productIds        String[]                    // used when scope = PRODUCT
  categoryIds       String[]                    // used when scope = CATEGORY
  startsAt          DateTime?
  expiresAt         DateTime?
  usageLimit        Int?                        // total redemptions allowed
  usedCount         Int           @default(0)
  isActive          Boolean       @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  sales          Sale[]
  vouchers Voucher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
}


model Voucher {
  id             String    @id @default(uuid())
  code           String    @unique        // 8 chars, no look-alikes; shown as XXXX-XXXX
  phone          String?
  customerName   String?
  expiresAt      DateTime?                // the coupon's own end date can still cut it shorter
  redeemedAt     DateTime?
  redeemedSaleId String?
  smsSentAt      DateTime?
  smsError       String?

  couponId       String
  coupon         Coupon       @relation(fields: [couponId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([phone])
}