// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


enum Role {
  OWNER
  CASHIER
}

enum Plan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum OrganizationType {
  RETAIL 
  WHOLESALE 
  GROCERY 
  SUPERMARKET 
  PHARMACY 
  RESTAURANT 
  CAFE 
  BAKERY 
  ELECTRONICS 
  FASHION 
  HARDWARE 
  BEAUTY 
  BOOKSTORE 
  STATIONERY 
  AUTO_PARTS 
  MOBILE_SHOP 
  FURNITURE 
  WAREHOUSE 
  DISTRIBUTION 
  MANUFACTURING 
  ECOMMERCE 
  SERVICE 
  HOSPITAL 
  CLINIC 
  AGRICULTURE 
  OTHER 
}

enum PaymentMethod {
  CASH
  MOMO
  CARD
}



model Organization{
  id  String @id @default(uuid())
  organizationName String
  organizationType OrganizationType
  location String
  contact String
  plan               Plan               @default(FREE)
  subscriptionStatus SubscriptionStatus @default(INACTIVE)
  subscriptionExpiry DateTime?
  paystackCustomerId String?
  createdAt  DateTime @default(now())

  users User[]
  products Product[]
  categories Category[]
  
  sales Sale[]
}

model User{
  id String @id @default(uuid())
  name String
  email String @unique
  password String
  role Role @default(CASHIER)
  resetToken      String?
resetTokenExpiry DateTime?

  organizationId String
  organization  Organization @relation(fields:[organizationId], references: [id]) 
  sales Sale[]

  createdAt DateTime @default(now())
}

model Product {
  id        String   @id @default(uuid())
  name      String
  costPrice     Float
  sellingPrice     Float
  quantity  Int      @default(0)
  barcode String? @unique
  imageUrl String?
  createdAt DateTime @default(now())

  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id])

  

  categoryId String
category   Category @relation(fields: [categoryId], references: [id])
  saleItems SaleItem[]

 
}


model Category {
  id   String @id @default(uuid())
  name String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  products Product[]
}







model Sale{
  id           String       @id @default(uuid())
  totalAmount Float
  
  createdAt DateTime @default(now())
  items SaleItem[]
  amountPaid    Float?
  paymentMethod PaymentMethod?
  change       Float? 

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId String
user   User @relation(fields: [userId], references: [id])
  
}

model SaleItem{
  id String @id @default(uuid())
  quantity Int
  priceAtSale Float
  
  createdAt DateTime @default(now())

  saleId String
  sales Sale @relation(fields: [saleId] , references:[id])
  productId String
product   Product @relation(fields: [productId], references: [id])

}